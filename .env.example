# ──────────────────────────────────────────────────────────────────────────
# Qavio — Environment Variables
# Copy this file to .env.local (apps) or .env (workers/scripts) and fill in
# real values. NEVER commit the filled-in file. See docs/environment-variables.md
# for a full explanation of every variable and where it is consumed.
# ──────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
# Public base URL of the web app. Safe to expose to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Supabase (Control Plane database + auth) ────────────────────────────
# Public: safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: bypasses Row Level Security. NEVER expose to the browser or
# any client-side bundle. Used only in server actions, route handlers, and
# workers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Server-only, same project as NEXT_PUBLIC_SUPABASE_URL above (not itself a
# secret — it's just an identifier) but read under its own non-prefixed name
# so workers/* never has to depend on any NEXT_PUBLIC_* variable existing.
# Required by workers/*; apps/web never reads this one.
SUPABASE_URL=https://your-project.supabase.co

# ── Redis / Queue (BullMQ) ──────────────────────────────────────────────
# Server + worker only. Never exposed to the browser.
REDIS_URL=redis://localhost:6379

# ── AI Provider (used by future AI analysis workers) ────────────────────
# Server-only. Never exposed to the browser.
ANTHROPIC_API_KEY=

# ── Worker configuration (execution plane) ──────────────────────────────
# Consumed only by workers/*, never by apps/web on the client. Default (2)
# is fine for the deterministic Phase 6 placeholder; the first production
# deployment of the real Playwright engine (see docs/railway-deployment.md)
# should set WORKER_CONCURRENCY=1 instead — Chromium is far heavier per job
# than that placeholder, and concurrency should only be raised deliberately
# once real resource usage under load is known.
WORKER_CONCURRENCY=2
TEST_RUN_TIMEOUT_MS=300000

# Local-development ONLY escape hatch for Phase 7's Playwright QA engine's
# SSRF protection (workers/web/src/security/target-validation.ts) — every
# reachable address on your own machine (localhost, 127.0.0.1, a LAN IP) is
# correctly blocked as a private/loopback address, so running the engine
# against apps/qa-fixture locally requires explicitly allowlisting it here.
# Comma-separated `hostname:port` entries. Leave EMPTY in every deployed
# environment; this is never read from anything a user controls.
PLAYWRIGHT_LOCAL_TEST_TARGET_ALLOWLIST=

# ── Integrations (future: Jira, ClickUp, Notion, Linear, GitHub, GitLab) ─
# Left empty in this phase. Populated as each integration is implemented.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
