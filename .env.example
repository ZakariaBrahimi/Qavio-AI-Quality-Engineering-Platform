# ──────────────────────────────────────────────────────────────────────────
# Qavio — Environment Variables
# Copy this file to .env.local (apps) or .env (workers/scripts) and fill in
# real values. NEVER commit the filled-in file. See docs/environment-variables.md
# for a full explanation of every variable and where it is consumed.
# ──────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
# Public base URL of the web app. Safe to expose to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Supabase (Control Plane database + auth) ────────────────────────────
# Public: safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: bypasses Row Level Security. NEVER expose to the browser or
# any client-side bundle. Used only in server actions, route handlers, and
# workers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Redis / Queue (BullMQ) ──────────────────────────────────────────────
# Server + worker only. Never exposed to the browser.
REDIS_URL=redis://localhost:6379

# ── AI Provider (used by future AI analysis workers) ────────────────────
# Server-only. Never exposed to the browser.
ANTHROPIC_API_KEY=

# ── Worker configuration (execution plane) ──────────────────────────────
# Consumed only by workers/*, never by apps/web on the client.
WORKER_CONCURRENCY=2
TEST_RUN_TIMEOUT_MS=300000

# ── Integrations (future: Jira, ClickUp, Notion, Linear, GitHub, GitLab) ─
# Left empty in this phase. Populated as each integration is implemented.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
