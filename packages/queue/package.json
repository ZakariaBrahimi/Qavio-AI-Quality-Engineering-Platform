{
  "name": "@qavio/queue",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ test-run queue abstraction shared by the control plane (apps/web, producer) and the execution plane (workers/*, consumer) — the only place either side should import BullMQ from directly.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@qavio/types": "workspace:*",
    "bullmq": "^5.13.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@qavio/config": "workspace:*",
    "@qavio/eslint-config": "workspace:*",
    "@qavio/testing": "workspace:*",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
