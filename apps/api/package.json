{
  "name": "@qavio/api",
  "version": "0.1.0",
  "private": true,
  "description": "Qavio internal API service — health checks and future service-to-service endpoints (webhook receivers, worker callbacks).",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@qavio/config": "workspace:*",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@qavio/eslint-config": "workspace:*",
    "@qavio/testing": "workspace:*",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
